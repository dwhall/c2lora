{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nim YesDrX",
      "type": "cppdbg",
      "request": "launch",
      //"program": "${fileDirname}/${fileBasenameNoExtension}",
      "program": "${workspaceFolder}/build/main.elf",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "nim_debugger_mi",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "BMP nRF52",
      "type": "cortex-debug", // Requires Cortex-Debug extension (marus25.cortex-debug)
      "request": "launch",

      "servertype": "external",
      "gdbTarget": "COM2", // Adjust this to your BMP's COM port

      "executable": "${workspaceFolder}/build/main.elf",
      "device": "nRF52",
      "interface": "swd",

      "runToEntryPoint": "Reset_Handler",
      "svdFile": "${workspaceFolder}deps/svd/nrf52840.svd",

      "gdbPath": "arm-none-eabi-gdb",

      "overrideLaunchCommands": [
        "file build/main.elf",
        "monitor swd_scan",
        "attach 1",
        "load",
        // For RTT support, install ms-vscode.vscode-serial-monitor extension
        // and configure a serial monitor to connect to the RTT port (the COM
        // port not used by the entended-remote connection)
        "monitor rtt ram 0x20000000 0x20040000",
        "monitor rtt channel 0",
        "monitor rtt enable",
        "monitor rtt cb"
      ],

      // @YesDrX
      "miDebuggerPath": "${userHome}/.nimble/bin/nim_debugger_mi.cmd",
      "miDebuggerArgs": "--gdb=D:\\Program Files\\Arm GNU Toolchain arm-none-eabi\\14.3 rel1\\bin\\arm-none-eabi-gdb.exe", //you may specify gdb path by --gdb=/path/to/your/gdb.exe
      "MIMode": "gdb",
      "args": [],
      "cwd": "${workspaceFolder}"

    }
  ]
}